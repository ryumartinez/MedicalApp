@page "/account/set-password"
@model MedicalApp.Features.Identity.Pages.Account.SetPasswordModel
@{
    ViewData["Title"] = "Set your password";
}
@if (Model.Completed)
{
    <h1>Password set</h1>
    <p>You can now sign in with your new password from the app you were invited to.</p>
}
else if (Model.LinkInvalid)
{
    <h1>Link not valid</h1>
    <p>@SetPasswordModel.InvalidLinkMessage</p>
}
else
{
    <h1>Set your password</h1>
    <p>Choose a password with at least @Model.MinimumLength characters. A long phrase is easiest to remember.</p>
    <form method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <label asp-for="Input.Password">New password</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" minlength="@Model.MinimumLength" autofocus required />
        <label asp-for="Input.ConfirmPassword">Confirm password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
        @if (Model.Errors.Count != 0)
        {
            <ul class="error" role="alert">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
        <button type="submit">Set password</button>
    </form>
}
