@page
@model MedicalApp.Features.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p>Use the account your clinic gave you.</p>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Input.Username">Username</label>
    <input asp-for="Input.Username" autocomplete="username" autofocus required />
    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
    @if (Model.ErrorMessage is not null)
    {
        <p class="error" role="alert">@Model.ErrorMessage</p>
    }
    <button type="submit">Sign in</button>
</form>
